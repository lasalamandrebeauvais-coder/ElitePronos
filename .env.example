# =====================================================
# ELITE PRONOS - CONFIGURATION ENVIRONNEMENT
# =====================================================
# Copiez ce fichier en .env et remplissez vos valeurs
# NE JAMAIS COMMITER LE FICHIER .env SUR GITHUB

# =====================================================
# MODE APPLICATION
# =====================================================
# False = Mode Test (emails simules, pas d'envoi reel)
# True = Mode Officiel (emails reels envoyes)
IS_OFFICIEL=False

# =====================================================
# CONFIGURATION SMTP (Gmail)
# =====================================================
# Pour Gmail, utilisez un "Mot de passe d'application"
# https://myaccount.google.com/apppasswords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=elite.pronos.2@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_application

# =====================================================
# API FOOTBALL-DATA (optionnel)
# =====================================================
# Cle API pour importer les matchs
# https://www.football-data.org/

FOOTBALL_API_KEY=votre_cle_api

# =====================================================
# NOTES STREAMLIT CLOUD
# =====================================================
# Sur Streamlit Cloud, configurez ces variables dans:
# Settings > Secrets
#
# Format TOML:
# [secrets]
# IS_OFFICIEL = "False"
# SMTP_HOST = "smtp.gmail.com"
# SMTP_PORT = "587"
# SMTP_USER = "elite.pronos.2@gmail.com"
# SMTP_PASSWORD = "xxxx xxxx xxxx xxxx"
